# Porta onde a API vai rodar
PORT=3000

# String de conexão com o PostgreSQL
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL=postgresql://usuario:senha@localhost:5432/service-control

# Segredo usado para assinar os tokens JWT — use uma string longa e aleatória em produção
JWT_SECRET=troque-por-uma-string-longa-e-segura

# Tempo de expiração do token JWT (ex: 7d, 24h, 60m)
JWT_EXPIRES_IN=7d

# Origem permitida pelo CORS (use * para qualquer origem, ou especifique o domínio do frontend)
CORS_ORIGIN=*

# URL do frontend — usada para montar o link de redefinição de senha nos e-mails
FRONTEND_URL=http://localhost:3001

# Configurações de e-mail SMTP (opcional em desenvolvimento — sem elas o link aparece no console)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu@email.com
SMTP_PASS=sua-senha-de-app
SMTP_FROM=noreply@servicecontrol.com

# ── Storage de fotos ─────────────────────────────────────────
# Caminho local usado quando R2 não está configurado (dev/fallback)
UPLOAD_DIR=./uploads
# URL base pública desta API — usada para servir fotos do disco em /uploads/<key>
# Em produção: https://api.seudominio.com  (em dev pode deixar vazio para usar http://localhost:PORT)
PUBLIC_BASE_URL=

# ── Cloudflare R2 (recomendado em produção) ──────────────────
# Como criar:
#   1. Crie uma conta grátis em https://dash.cloudflare.com (10 GB grátis, sem custo de saída)
#   2. R2 → Create bucket (ex.: service-control-photos)
#   3. R2 → Manage R2 API Tokens → Create API Token (Object Read & Write)
#   4. Copie endpoint, access key id e secret abaixo
# Se qualquer R2_* abaixo ficar vazio, o sistema usa o disco local automaticamente.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# (Opcional) Domínio público do bucket — se setado, evita gerar presigned URLs.
# Use só se o bucket tiver acesso público ativado.
R2_PUBLIC_BASE_URL=
