# Porta onde a API vai rodar
PORT=3000

# String de conexão com o PostgreSQL
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL=postgresql://usuario:senha@localhost:5432/service-control

# Segredo usado para assinar os tokens JWT — use uma string longa e aleatória em produção
JWT_SECRET=troque-por-uma-string-longa-e-segura

# Tempo de expiração do token JWT (ex: 7d, 24h, 60m)
JWT_EXPIRES_IN=7d

# Origem permitida pelo CORS (use * para qualquer origem, ou especifique o domínio do frontend)
CORS_ORIGIN=*

# URL do frontend — usada para montar o link de redefinição de senha nos e-mails
FRONTEND_URL=http://localhost:3001

# Configurações de e-mail SMTP (opcional em desenvolvimento — sem elas o link aparece no console)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu@email.com
SMTP_PASS=sua-senha-de-app
SMTP_FROM=noreply@servicecontrol.com
