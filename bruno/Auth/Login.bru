meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "maria@email.com",
    "password": "senha123"
  }
}

script:post-response {
  // Equivalente do test script do Postman: salva o token na env atual
  // pra que demais requests herdem o Bearer auth automaticamente.
  const body = res.getBody();
  if (body && body.token) {
    bru.setEnvVar('token', body.token);
    console.log('Token salvo automaticamente.');
  }
}
