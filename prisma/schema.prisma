generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model plan {
  id          Int      @id @default(autoincrement()) @map("id")
  name        String   @unique @map("name")
  description String?  @map("description")
  price       Decimal  @map("price") @db.Decimal(10, 2)
  features    Json     @map("features")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users user[]

  @@map("plan")
}

model user {
  id                Int       @id @default(autoincrement()) @map("id")
  name              String    @map("name")
  email             String    @unique @map("email")
  passwordHash      String    @map("password_hash")
  role              String    @default("user") @map("role")
  planId            Int?      @map("plan_id")
  isActive          Boolean   @default(true) @map("is_active")
  resetToken        String?   @unique @map("reset_token")
  resetTokenExpires DateTime? @map("reset_token_expires")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  plan            plan?    @relation(fields: [planId], references: [id])
  clients         client[]
  procedure_types procedure_type[]
  products        product[]
  services        service[]
  expenses        expense[]
  appointments    appointment[]
  calendarIntegration calendar_integration?
  availabilityRules   availability_rule[]
  blockedTimes        blocked_time[]

  @@map("user")
}

model client {
  id        Int       @id @default(autoincrement()) @map("id")
  userId    Int       @map("user_id")
  name      String    @map("name")
  phone     String?   @map("phone")
  email     String?   @map("email")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user         user          @relation(fields: [userId], references: [id])
  services     service[]
  photos       client_photo[]
  appointments appointment[]

  @@index([userId, deletedAt])
  @@map("client")
}

model client_photo {
  id        Int       @id @default(autoincrement()) @map("id")
  userId    Int       @map("user_id")
  clientId  Int       @map("client_id")

  // Object storage (R2/S3 or local)
  bucketKey String?   @map("bucket_key")
  thumbKey  String?   @map("thumb_key")

  // Legacy disk uploads — kept so old records keep displaying
  filename  String?   @map("filename")

  // Metadata
  mimeType  String?   @map("mime_type")
  sizeBytes Int?      @map("size_bytes")
  width     Int?      @map("width")
  height    Int?      @map("height")

  // Domain
  tag       String?   @map("tag")
  notes     String?   @map("notes")
  takenAt   DateTime  @map("taken_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  client client @relation(fields: [clientId], references: [id])

  @@index([clientId, deletedAt])
  @@index([userId, deletedAt])
  @@map("client_photo")
}

model procedure_type {
  id                      Int       @id @default(autoincrement()) @map("id")
  userId                  Int       @map("user_id")
  name                    String    @map("name")
  description             String?   @map("description")
  costValue               Decimal?  @map("cost_value") @db.Decimal(10, 2)
  finalValue              Decimal?  @map("final_value") @db.Decimal(10, 2)
  defaultDurationMinutes  Int?      @map("default_duration_minutes")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")
  deletedAt               DateTime? @map("deleted_at")

  user               user                     @relation(fields: [userId], references: [id])
  service_procedures service_procedure[]
  products           procedure_type_product[]
  appointments       appointment[]

  @@index([userId, deletedAt])
  @@map("procedure_type")
}

/// Produtos usados em um tipo de procedimento (com quantidade)
model procedure_type_product {
  id              Int     @id @default(autoincrement()) @map("id")
  procedureTypeId Int     @map("procedure_type_id")
  productId       Int     @map("product_id")
  quantity        Decimal @map("quantity") @db.Decimal(10, 3)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  procedureType procedure_type @relation(fields: [procedureTypeId], references: [id])
  product       product        @relation(fields: [productId], references: [id])

  @@unique([procedureTypeId, productId])
  @@index([productId, deletedAt])
  @@map("procedure_type_product")
}

/// Um atendimento agora pode ter múltiplos procedimentos
model service {
  id          Int       @id @default(autoincrement()) @map("id")
  userId      Int       @map("user_id")
  clientId    Int       @map("client_id")
  description String?   @map("description")
  totalPrice  Decimal   @map("total_price")
  date        DateTime  @default(now()) @map("date")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  user             user                @relation(fields: [userId], references: [id])
  client           client              @relation(fields: [clientId], references: [id])
  procedures       service_procedure[]
  expenses         expense[]
  profit           profit?
  service_products service_product[]
  appointment      appointment?

  @@index([userId, deletedAt])
  @@index([clientId, deletedAt])
  @@index([userId, date])
  @@map("service")
}

/// Junção: quais procedimentos foram realizados no atendimento e por qual preço
model service_procedure {
  id              Int     @id @default(autoincrement()) @map("id")
  serviceId       Int     @map("service_id")
  procedureTypeId Int     @map("procedure_type_id")
  price           Decimal @map("price")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  service       service        @relation(fields: [serviceId], references: [id])
  procedureType procedure_type @relation(fields: [procedureTypeId], references: [id])

  @@index([serviceId])
  @@index([procedureTypeId])
  @@map("service_procedure")
}

/// Despesas gerais (aluguel, transporte…) OU vinculadas a um atendimento
model expense {
  id        Int       @id @default(autoincrement()) @map("id")
  userId    Int       @map("user_id")
  serviceId Int?      @map("service_id")
  category  String    @map("category")
  amount    Decimal   @map("amount")
  notes     String?   @map("notes")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  user    user     @relation(fields: [userId], references: [id])
  service service? @relation(fields: [serviceId], references: [id])

  @@index([userId, deletedAt])
  @@index([serviceId, deletedAt])
  @@index([userId, createdAt])
  @@map("expense")
}

model product {
  id          Int       @id @default(autoincrement()) @map("id")
  userId      Int       @map("user_id")
  name        String    @map("name")
  description String?   @map("description")
  unitCost    Decimal   @map("unit_cost")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  user              user                     @relation(fields: [userId], references: [id])
  inventory         inventory?
  usedIn            service_product[]
  procedure_types   procedure_type_product[]

  @@index([userId, deletedAt])
  @@map("product")
}

model inventory {
  id            Int       @id @default(autoincrement()) @map("id")
  productId     Int       @unique @map("product_id")
  quantity      Decimal   @map("quantity") @db.Decimal(10, 3)
  purchasePrice Decimal?  @map("purchase_price") @db.Decimal(10, 2)
  updatedAt     DateTime  @updatedAt @map("updated_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  deletedAt     DateTime? @map("deleted_at")

  product product @relation(fields: [productId], references: [id])

  @@map("inventory")
}

model service_product {
  id        Int       @id @default(autoincrement()) @map("id")
  serviceId Int       @map("service_id")
  productId Int       @map("product_id")
  quantity  Decimal   @map("quantity") @db.Decimal(10, 3)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  service service @relation(fields: [serviceId], references: [id])
  product product @relation(fields: [productId], references: [id])

  @@index([serviceId, deletedAt])
  @@index([productId, deletedAt])
  @@map("service_product")
}

model profit {
  id          Int       @id @default(autoincrement()) @map("id")
  serviceId   Int       @unique @map("service_id")
  totalProfit Decimal   @map("total_profit")
  marginPct   Decimal   @map("margin_pct")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  service service @relation(fields: [serviceId], references: [id])

  @@map("profit")
}

/// ── Agenda ──────────────────────────────────────────────────────
/// Compromisso futuro (criado antes do atendimento acontecer).
/// Quando concluído, o profissional pode criar o `service` correspondente
/// e o appointment fica ligado a ele via `serviceId`.
model appointment {
  id              Int       @id @default(autoincrement()) @map("id")
  userId          Int       @map("user_id")
  clientId        Int       @map("client_id")
  procedureTypeId Int?      @map("procedure_type_id")
  serviceId       Int?      @unique @map("service_id")

  startTime       DateTime  @map("start_time")
  endTime         DateTime  @map("end_time")

  /// scheduled | confirmed | in_progress | completed | canceled | no_show
  status          String    @default("scheduled") @map("status")
  notes           String?   @map("notes")

  /// Sync com Google Calendar (preenchidos quando integração ativa)
  googleEventId    String?   @map("google_event_id")
  googleCalendarId String?   @map("google_calendar_id")
  googleSyncedAt   DateTime? @map("google_synced_at")

  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  canceledAt   DateTime? @map("canceled_at")
  cancelReason String?   @map("cancel_reason")

  user          user            @relation(fields: [userId], references: [id])
  client        client          @relation(fields: [clientId], references: [id])
  procedureType procedure_type? @relation(fields: [procedureTypeId], references: [id])
  service       service?        @relation(fields: [serviceId], references: [id])

  @@index([userId, startTime])
  @@index([userId, status, startTime])
  @@index([clientId, startTime])
  @@index([googleEventId])
  @@map("appointment")
}

/// Conexão OAuth do profissional com um provedor de calendário (Google por enquanto).
/// Tokens armazenados criptografados (AES-256-GCM com CALENDAR_TOKEN_ENCRYPTION_KEY).
model calendar_integration {
  id            Int       @id @default(autoincrement()) @map("id")
  userId        Int       @unique @map("user_id")
  provider      String    @default("google") @map("provider")
  accessToken   String    @map("access_token")
  refreshToken  String    @map("refresh_token")
  tokenExpiry   DateTime  @map("token_expiry")
  scope         String    @map("scope")
  calendarId    String    @default("primary") @map("calendar_id")
  syncEnabled   Boolean   @default(true) @map("sync_enabled")
  syncToken     String?   @map("sync_token")
  lastSyncedAt  DateTime? @map("last_synced_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user user @relation(fields: [userId], references: [id])

  @@map("calendar_integration")
}

/// Horário de funcionamento por dia da semana (0=Dom..6=Sáb).
/// Minutos a partir da meia-noite (480 = 08:00, 1080 = 18:00).
model availability_rule {
  id           Int     @id @default(autoincrement()) @map("id")
  userId       Int     @map("user_id")
  dayOfWeek    Int     @map("day_of_week")
  startMinutes Int     @map("start_minutes")
  endMinutes   Int     @map("end_minutes")
  isActive     Boolean @default(true) @map("is_active")

  user user @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("availability_rule")
}

/// Bloqueios pontuais (almoço extra, feriado, viagem, etc.).
model blocked_time {
  id        Int      @id @default(autoincrement()) @map("id")
  userId    Int      @map("user_id")
  startTime DateTime @map("start_time")
  endTime   DateTime @map("end_time")
  reason    String?  @map("reason")
  createdAt DateTime @default(now()) @map("created_at")

  user user @relation(fields: [userId], references: [id])

  @@index([userId, startTime])
  @@map("blocked_time")
}
